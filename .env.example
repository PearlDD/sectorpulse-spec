# Required: Anthropic API key for Claude-powered analysis agents
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: FRED API key for macroeconomic indicators
# Register free at https://fred.stlouisfed.org/docs/api/api_key.html
# Without this key, macro indicators will be unavailable but RRG and price analysis still work
FRED_API_KEY=your-fred-api-key-here
